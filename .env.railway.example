# ── Database (MariaDB) ────────────────────────────────────────────────────────
# Railway has no native MariaDB plugin and Frappe does NOT support MySQL 8.
# MariaDB runs as a custom Docker service defined in docker/railway-compose.yml.
# When deployed via that compose file, use the service name "mariadb" as host.
DB_HOST=mariadb
DB_PORT=3306
DB_ROOT_PASSWORD=change-me-strong-password
DB_NAME=hrmsdb

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis runs as a custom Docker service defined in docker/railway-compose.yml.
# When deployed via that compose file, use the service name "redis" as host.
REDIS_CACHE_URL=redis://redis:6379
REDIS_QUEUE_URL=redis://redis:6379
REDIS_SOCKETIO_URL=redis://redis:6379

# ── Site ──────────────────────────────────────────────────────────────────────
SITE_NAME=hrms.localhost
ADMIN_PASSWORD=change-me-strong-password

# ── App versions ──────────────────────────────────────────────────────────────
FRAPPE_BRANCH=version-17
ERPNEXT_BRANCH=version-17
HRMS_BRANCH=main
HRMS_REPO=https://github.com/kamesh231/hrms-frappe.git
