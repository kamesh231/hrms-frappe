# ── Database (MariaDB 10.11) ──────────────────────────────────────────────────
# Add a MariaDB service in Railway and copy its connection variables here.
# Railway's built-in MySQL plugin is NOT compatible with Frappe — use MariaDB.
DB_HOST=mariadb.railway.internal
DB_PORT=3306
DB_ROOT_PASSWORD=change-me-strong-password
DB_NAME=hrmsdb

# ── Redis ─────────────────────────────────────────────────────────────────────
# Add the Redis plugin in Railway and use its REDIS_URL value below.
REDIS_CACHE_URL=redis://default:password@redis.railway.internal:6379
REDIS_QUEUE_URL=redis://default:password@redis.railway.internal:6379
REDIS_SOCKETIO_URL=redis://default:password@redis.railway.internal:6379

# ── Site ──────────────────────────────────────────────────────────────────────
SITE_NAME=hrms.localhost
ADMIN_PASSWORD=change-me-strong-password

# ── App versions ──────────────────────────────────────────────────────────────
FRAPPE_BRANCH=version-17
ERPNEXT_BRANCH=version-17
HRMS_BRANCH=main
HRMS_REPO=https://github.com/kamesh231/hrms-frappe.git
